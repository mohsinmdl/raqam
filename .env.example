# Copy to .env.local and fill in from your Supabase project
# (Dashboard → Project Settings → API). The anon/publishable key is safe to
# expose in the client bundle — Row Level Security is the security boundary.
# NEVER put the service_role / sb_secret_ key here or in any VITE_ variable.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Base URL of the deployed Raqam AI service (Modal). Public-class config, like
# the Supabase anon URL above — the JWT the client attaches is the security
# boundary, not the URL. OPTIONAL: leave it unset and the app works fully with
# every AI feature simply hidden (the AI-features toggle shows "Unavailable").
VITE_AI_ENDPOINT=https://your-org--raqam-ai-api.modal.run
