node_modules/
dist/
*.log
.DS_Store
.playwright-mcp/
*.png

# Environment — real keys never committed; .env.example is the template
.env
.env.*
!.env.example

# Bare secret files kept next to the app. `key` holds the Supabase service-role
# JWT, which bypasses RLS entirely — a far worse leak than the anon key.
key
*.jwt
*.pem
.ynab-token

# Local database dump produced by scripts/raqam-dump.sh — every user's rows.
.raqam-dump/

# Claude Code local state. Worktrees are full checkouts containing a .git
# file, so `git add .` stages them as gitlinks — broken submodule references
# that point at nothing for anyone else. settings.local.json is per-machine by
# name. Skills are left tracked-if-you-add-them, deliberately.
.claude/worktrees/
.claude/settings.local.json

# Supabase CLI local state
supabase/.temp/

# Impeccable (design skill) local runtime state. The committed artifacts are
# PRODUCT.md, DESIGN.md, .impeccable/design.json, and .impeccable/live/config.json;
# everything else here is per-machine session/cache state.
.impeccable/hook.cache.json
.impeccable/config.local.json
.impeccable/live/sessions/
.impeccable/live/accept-receipts/
.impeccable/live/roots.json
.impeccable/live/server.json
.impeccable/live/inject-journal.json

# Impeccable design skill — vendored copy is personal tooling, not app code.
.claude/skills/impeccable/

# Graphify — ignore regenerable data/cache/metadata; only the lightweight report
# and the standalone graph.html viewer are committed as shareable artifacts.
graphify-out/cache/
graphify-out/cost.json
graphify-out/manifest.json
graphify-out/graph.json
